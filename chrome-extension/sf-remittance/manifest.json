{
  "manifest_version": 3,
  "name": "Castle \u2014 Service Fusion Remittance Poster",
  "version": "0.8.13",
  "description": "Automates Castle Admin \u2194 Service Fusion (remittance posting, job notes) and logs vendor-portal orders (Genie/Home Depot, Clopay), all in your logged-in sessions.",
  "permissions": [
    "storage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://admin.servicefusion.com/*",
    "https://auth.servicefusion.com/*",
    "https://hq.castlegaragedoors.com/*",
    "https://install.openings.net/*",
    "https://*.clopay.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://install.openings.net/webcenter/portal/*"
      ],
      "js": [
        "content-genie.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hdprogram.clopay.com/*",
        "https://cca.clopay.com/*"
      ],
      "js": [
        "content-clopay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://install.openings.net/CustomLogin/*",
        "https://auth.servicefusion.com/*",
        "https://hq.castlegaragedoors.com/login*",
        "https://prod-iam.clopay.com/*",
        "https://cca.clopay.com/*",
        "https://hdprogram.clopay.com/*"
      ],
      "js": [
        "content-login.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SF Remittance Poster"
  },
  "options_page": "options.html"
}